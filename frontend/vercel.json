{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "NEXT_PUBLIC_SPACEGIT_PUBLIC=1 SPACEGIT_STATIC=1 pnpm build",
  "outputDirectory": "apps/web/out",
  "cleanUrls": true,
  "headers": [
    {"source":"/(.*)","headers":[{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]}
  ]
}
