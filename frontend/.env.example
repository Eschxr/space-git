# Set in the shell or use the start scripts. Keep the key off Vercel and out of NEXT_PUBLIC_*.
SPACEGIT_MODE=live
SPACEGIT_TOKEN=
# SPACEGIT_DATA=/absolute/private/directory
# SPACEGIT_COLMAP=/absolute/path/to/colmap
# SPACEGIT_MOBILE_ORIGIN=https://capture.example.net
# NEXT_PUBLIC_SPACEGIT_PUBLIC=1

# Initial rig mapping: 0 degrees, 120 degrees, 240 degrees, down toward the floor.
# Use primary, an index from 0 to 15, or -. Saved Capture settings take precedence.
# SPACEGIT_RIG_CAMERAS=primary,1,2,3
