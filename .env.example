POSTGRES_USER=scene_tracker
POSTGRES_PASSWORD=local-dev-change-me
POSTGRES_DB=scene_tracker
DATABASE_URL=postgresql+psycopg://scene_tracker:local-dev-change-me@localhost:5432/scene_tracker
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=scene_tracker
S3_SECRET_KEY=local-dev-change-me
S3_BUCKET=scene-tracker
PUBLIC_OBJECTSTORE_ENDPOINT=localhost:9000
MODEL_CACHE_DIR=./models
VISION_PROVIDER=fake
POINTDIT_CHECKPOINT=
DINOV3_WEIGHTS_DIR=
POINTDIT_SOURCE_DIR=
LOG_LEVEL=INFO
# Pinned S3-compatible PGSTY Silo server and bundled mcli bootstrap image.
SILO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-11-12T00-00-00Z@sha256:c20d112390b9a9ce8c11b8af95ad35bcaa62f4759663c09c936cd8d2b511f329
S3_SECURE=false
MAX_IMAGE_BYTES=20971520
MAX_IMAGE_PIXELS=40000000
MAX_TIMESTAMP_SKEW_SECONDS=2
# Real vision is opt-in. Install official local assets using docs/model-setup.md.
VISION_DEVICE=cpu
VISION_EXTRACTOR=yoloe
YOLOE_CHECKPOINT=
YOLOE_SHA256=
YOLOE_CONFIDENCE=0.25
YOLOE_IMGSZ=640
YOLOE_DEVICE=cpu
VISION_DINOV2_SOURCE_DIR=
VISION_DINOV2_CHECKPOINT=
VISION_DINOV2_SHA256=
VISION_CROP_PADDING=0.1
VISION_EMBEDDING_BATCH_SIZE=16
VISION_MIN_MASK_PIXELS=16
# Optional JSON overrides; defaults are illustrative, not calibrated.
# TRACKING={"movement_threshold":0.035,"minimum_score":0.65,"margin":0.08}
